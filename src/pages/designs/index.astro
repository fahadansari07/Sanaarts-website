---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WorkImage from '../../components/WorkImage.astro';
import CtaBand from '../../components/CtaBand.astro';
import { categories, designsIn } from '../../data/designs';
import { site } from '../../data/site';

const crumbs = [{ name: 'Designs', path: '/designs' }];
const rows = categories.map((c) => {
  const items = designsIn(c.slug);
  return { ...c, items, covers: items.filter((d) => d.image).slice(0, 3) };
});
const schema = [{
  '@type': 'CollectionPage',
  name: 'Mehandi design styles',
  hasPart: categories.map((c) => ({ '@type': 'CollectionPage', name: c.name, url: new URL(`/designs/${c.slug}`, Astro.site).href })),
}];
---
<Base
  title="Mehandi Design Styles — Bridal, Gulf, Kashmiri, Floral & More"
  description={`Browse ${categories.length} mehandi styles by Sana Hashmi: bridal, engagement, feet and legs, Gulf/Doha, Kashmiri, floral, patchwork, minimal, Eid and stain results — real work from Instagram.`}
  breadcrumbs={crumbs}
  schema={schema}
>
  <Breadcrumbs items={crumbs} />
  <section class="section intro">
    <div class="wrap section-head">
      <span class="eyebrow">Designs</span>
      <h1>Which mehandi style <em>suits you?</em></h1>
      <p class="lead">{site.artist} works across {categories.length} styles. Each page below shows her real designs from Instagram, ordered by popularity, with a link to every original post.</p>
    </div>
  </section>

  <section class="wrap list">
    {rows.map((c, i) => (
      <article class="row reveal">
        <div class="copy">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h2><a href={`/designs/${c.slug}`}>{c.name}</a></h2>
          <p>{c.intro}</p>
          <a class="link-arrow" href={`/designs/${c.slug}`}>View {c.items.length} {c.items.length === 1 ? 'design' : 'designs'}</a>
        </div>
        <div class:list={['thumbs', `n${c.covers.length}`]}>
          {c.covers.map((d) => (
            <a href={`/designs/${c.slug}`} tabindex="-1" aria-hidden="true"><WorkImage design={d} widths={[240, 360, 480]} sizes="(max-width: 760px) 30vw, 14vw" /></a>
          ))}
          {c.covers.length === 0 && <p class="no-img">Reels — watch on the style page</p>}
        </div>
      </article>
    ))}
  </section>

  <CtaBand />
</Base>

<style>
  .intro { padding-bottom: 32px; }
  .list { padding-bottom: clamp(64px, 9vw, 120px); }
  .row { display: grid; grid-template-columns: 1fr 1.05fr; gap: 48px; align-items: center; padding: 40px 0; border-top: 1px solid var(--line); }
  .num { font-family: var(--font-serif); font-style: italic; color: var(--gold); font-size: 1.3rem; }
  h2 { margin: 6px 0 12px; font-size: clamp(1.7rem, 3vw, 2.3rem); }
  h2 a { text-decoration: none; }
  h2 a:hover { color: var(--henna); }
  .copy p { color: var(--muted); max-width: 52ch; }
  .thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .thumbs a { display: block; aspect-ratio: 4 / 5; border-radius: 10px; overflow: hidden; background: var(--sand); }
  .thumbs :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .row:hover .thumbs :global(img) { transform: scale(1.04); }
  .no-img { grid-column: 1 / -1; margin: 0; padding: 48px 24px; text-align: center; border: 1px dashed var(--line); border-radius: 10px; color: var(--muted); font-family: var(--font-serif); font-style: italic; font-size: 1.2rem; }
  @media (max-width: 760px) { .row { grid-template-columns: 1fr; gap: 20px; } }
</style>
