---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn’t exist. Explore Sana Hashmi’s mehandi designs or book on WhatsApp." noindex>
  <section class="section">
    <div class="wrap section-head section-head--center">
      <span class="eyebrow">404</span>
      <h1>This page has <em>faded</em> like old henna</h1>
      <p class="lead">The page you were looking for doesn’t exist.</p>
      <div class="btn-row" style="justify-content:center;margin-top:24px">
        <a class="btn btn--solid" href="/">Go home</a>
        <a class="btn btn--ghost" href="/gallery">See the gallery</a>
      </div>
    </div>
  </section>
</Base>
