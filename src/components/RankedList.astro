---
import WorkImage from './WorkImage.astro';
import { formatCount, postUrl, type Design } from '../data/designs';
interface Props { items: Design[]; start?: number }
const { items, start = 1 } = Astro.props;
---
<ol class="ranked" start={start}>
  {items.map((d, i) => (
    <li class="reveal">
      <a href={postUrl(d)} target="_blank" rel="noopener" aria-label={`#${start + i} ${d.label}, ${d.views ? formatCount(d.views, d.viewsApprox) + ' views' : ''} — watch on Instagram`}>
        <span class="n">{String(start + i).padStart(2, '0')}</span>
        <span class="thumb">
          {d.image ? <WorkImage design={d} widths={[160, 240]} sizes="80px" /> : <span class="ring" aria-hidden="true"></span>}
        </span>
        <span class="t">
          <span class="label">{d.label}</span>
          <span class="note">“{d.note}”{d.collab ? ` · with ${d.collab}` : ''}</span>
        </span>
        <span class="v">
          {d.views && <span class="views">{formatCount(d.views, d.viewsApprox)}</span>}
          <span class="vl">views{d.saves ? ` · ${formatCount(d.saves)} saves` : ''}</span>
        </span>
        <span class="go" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ol>

<style>
  .ranked { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  li { border-bottom: 1px solid var(--line); }
  a {
    display: grid; grid-template-columns: 3rem 64px 1fr auto 1.5rem; align-items: center; gap: 20px;
    padding: 16px 8px; text-decoration: none; color: inherit; transition: background-color .3s var(--ease), padding .3s var(--ease);
  }
  a:hover { background: rgb(241 230 216 / .6); padding-inline: 16px 12px; }
  .n { font-family: var(--font-serif); font-style: italic; font-size: 1.6rem; color: var(--gold); }
  .thumb { width: 64px; height: 80px; border-radius: 8px; overflow: hidden; background: var(--sand); display: grid; place-items: center; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ring { width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--henna); position: relative; opacity: .7; }
  .ring::after { content: ''; position: absolute; left: 10px; top: 7px; border-left: 9px solid var(--henna); border-top: 6px solid transparent; border-bottom: 6px solid transparent; }
  .t { display: grid; gap: 2px; min-width: 0; }
  .label { font-family: var(--font-serif); font-size: 1.35rem; line-height: 1.2; }
  a:hover .label { color: var(--henna); }
  .note { font-size: .85rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .v { text-align: right; display: grid; }
  .views { font-family: var(--font-serif); font-size: 1.7rem; line-height: 1; color: var(--henna); }
  .vl { font-size: .75rem; color: var(--muted); letter-spacing: .04em; }
  .go { color: var(--henna); transition: transform .3s var(--ease); }
  a:hover .go { transform: translate(2px, -2px); }
  @media (max-width: 640px) {
    a { grid-template-columns: 2.2rem 52px 1fr auto; gap: 12px; padding: 14px 0; }
    a:hover { padding-inline: 0; }
    .thumb { width: 52px; height: 64px; }
    .go { display: none; }
    .label { font-size: 1.15rem; }
    .views { font-size: 1.35rem; }
    .vl { font-size: .7rem; }
  }
</style>
