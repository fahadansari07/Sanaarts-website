---
import { stats } from '../data/site';
const items = [
  { value: stats.totalReelViews, label: `reel views across ${stats.reelCount} reels` },
  { value: String(stats.reelsOver100k), label: 'reels with 100K+ views' },
  { value: stats.topSaves, label: 'saves on a single design' },
  { value: stats.newViewerShare, label: 'of viral-reel viewers were new to the page' },
];
---
<section class="stats" aria-label="Instagram reach">
  <div class="wrap">
    <dl class="row">
      {items.map((i) => (
        <div class="item reveal">
          <dt>{i.label}</dt>
          <dd>{i.value}</dd>
        </div>
      ))}
    </dl>
    <p class="source">Source: {stats.source}.</p>
  </div>
</section>

<style>
  .stats { border-block: 1px solid var(--line); padding: 40px 0 22px; }
  .row { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; }
  .item { display: flex; flex-direction: column-reverse; justify-content: flex-end; padding: 4px 24px; border-left: 1px solid var(--line); }
  .item:first-child { border-left: 0; padding-left: 0; }
  dd { margin: 0; font-family: var(--font-serif); font-size: clamp(2.2rem, 4vw, 3.1rem); line-height: 1; color: var(--henna); }
  dt { margin-top: 10px; font-size: .9rem; color: var(--muted); max-width: 22ch; }
  .source { margin: 22px 0 0; font-size: .75rem; color: var(--muted); letter-spacing: .04em; }
  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr 1fr; row-gap: 28px; }
    .item:nth-child(3) { border-left: 0; padding-left: 0; }
  }
</style>
