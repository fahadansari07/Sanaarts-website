---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs wrap" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((c, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>
    ))}
  </ol>
</nav>

<style>
  .crumbs { padding-top: 28px; }
  ol { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; font-size: .85rem; color: var(--muted); }
  li + li::before { content: '/'; margin-right: 8px; color: var(--line); }
  a { text-decoration: none; }
  a:hover { color: var(--henna); text-decoration: underline; }
  [aria-current] { color: var(--ink); }
</style>
