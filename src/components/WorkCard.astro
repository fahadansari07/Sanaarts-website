---
import WorkImage from './WorkImage.astro';
import { formatCount, postUrl, type Design } from '../data/designs';

interface Props { design: Design; rank?: number; sizes?: string; eager?: boolean; showStats?: boolean }
const { design, rank, sizes, eager, showStats = true } = Astro.props;
const views = showStats && design.views ? formatCount(design.views, design.viewsApprox) : null;
const kind = design.kind === 'reel' ? 'Reel' : 'Photo';
---
<a class="card" href={postUrl(design)} target="_blank" rel="noopener"
   aria-label={`${design.label}${views ? `, ${views} views` : ''} — open ${kind.toLowerCase()} on Instagram`}>
  <div class="media">
    {design.image ? (
      <WorkImage design={design} sizes={sizes} eager={eager} />
    ) : (
      <div class="placeholder" aria-hidden="true">
        <span class="play"></span>
        <span class="ph-label">{design.label}</span>
        <span class="ph-cta">Watch on Instagram</span>
      </div>
    )}
    {design.kind === 'reel' && design.image && <span class="play play--corner" aria-hidden="true"></span>}
    {views && <span class="badge">{views} views</span>}
  </div>
  <div class="meta">
    {rank && <span class="rank">{String(rank).padStart(2, '0')}</span>}
    <span class="text">
      <span class="label">{design.label}</span>
      <span class="sub">{kind}{design.saves ? ` · ${formatCount(design.saves)} saves` : ''}{design.collab ? ` · with ${design.collab}` : ''}</span>
    </span>
  </div>
</a>

<style>
  .card { display: block; text-decoration: none; color: inherit; }
  .media {
    position: relative; overflow: hidden; border-radius: var(--radius);
    background: var(--sand); aspect-ratio: 4 / 5;
  }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .card:hover .media :global(img) { transform: scale(1.04); }
  .badge {
    position: absolute; left: 12px; bottom: 12px; padding: 6px 12px; border-radius: 999px;
    background: rgb(250 246 240 / .92); color: var(--henna); font-size: .8rem; font-weight: 500; letter-spacing: .02em;
    backdrop-filter: blur(6px);
  }
  .play { width: 52px; height: 52px; border-radius: 50%; border: 1px solid currentColor; display: grid; place-items: center; }
  .play::after { content: ''; border-left: 13px solid currentColor; border-top: 8px solid transparent; border-bottom: 8px solid transparent; margin-left: 4px; }
  .play--corner { position: absolute; top: 12px; right: 12px; width: 38px; height: 38px; color: #fff; background: rgb(43 33 28 / .35); border-color: rgb(255 255 255 / .7); backdrop-filter: blur(4px); }
  .play--corner::after { border-left-width: 10px; border-top-width: 6px; border-bottom-width: 6px; margin-left: 3px; }
  .placeholder {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 14px;
    padding: 24px; text-align: center; color: var(--henna);
    background:
      radial-gradient(circle at 50% 38%, transparent 0 58px, rgb(110 42 31 / .08) 59px 60px, transparent 61px 84px, rgb(110 42 31 / .06) 85px 86px, transparent 87px),
      var(--sand);
    transition: background-color .4s var(--ease);
  }
  .card:hover .placeholder { background-color: var(--sand-deep); }
  .ph-label { font-family: var(--font-serif); font-size: 1.5rem; line-height: 1.15; color: var(--ink); margin-top: 6px; }
  .ph-cta { font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .meta { display: flex; gap: 14px; align-items: baseline; padding: 14px 2px 0; }
  .rank { font-family: var(--font-serif); font-style: italic; font-size: 1.35rem; color: var(--gold); min-width: 1.6em; }
  .text { display: grid; gap: 2px; }
  .label { font-family: var(--font-serif); font-size: 1.3rem; line-height: 1.2; }
  .card:hover .label { color: var(--henna); }
  .sub { font-size: .82rem; color: var(--muted); }
</style>
